# Used when running the API by hand. install.sh writes /etc/price-app.env on the server.
DATABASE_URL=postgres://price:change-me-strong-password@127.0.0.1:5432/price
# at least 32 characters: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
# true = overwrite that admin's password from ADMIN_PASSWORD on the next API start
ADMIN_SYNC_PASSWORD=false

LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=
# baked into the website at build time, e.g. @merichly
LINE_OA_ID=

SKIP_SEED=true
UPLOAD_DIR=./uploads
DB_DIR=../db
PORT=3000
HOST=127.0.0.1
